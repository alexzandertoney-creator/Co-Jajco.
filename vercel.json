{
  "version": 2,
  "builds": [
    {
      "src": "Server/server.js",
      "use": "@vercel/node"
    },
    {
      "src": "public/**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "Server/server.js"
    },
    {
      "src": "/library/starter/?",
      "dest": "public/recommended.html"
    },
    {
      "src": "/(study|study/learn|study/test|study/match|decks|stories|grammar|notes|library|profile)/?",
      "dest": "public/index.html"
    },
    {
      "src": "/review/?",
      "dest": "public/smartReview.html"
    },
    {
      "src": "/login/?",
      "dest": "public/login.html"
    },
    {
      "src": "/register/?",
      "dest": "public/register.html"
    },
    {
      "src": "/(.*)",
      "dest": "public/$1"
    }
  ]
}
