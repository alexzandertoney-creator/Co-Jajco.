# Copy this file to .env and fill in the values. Never commit .env.

# PostgreSQL connection string (Supabase/Neon: use the pooled "Session pooler" URI)
DATABASE_URL=postgresql://user:password@host:5432/postgres

# Long random string used to sign login tokens. Required in production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Port for local development
PORT=3000
